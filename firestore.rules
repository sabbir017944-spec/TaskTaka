rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "K9T43VfmBHVormBGg8kUb5eYM3m1";
    }

    // A user can only read their own profile.
    match /users/{userId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == userId);

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid','displayName','email','createdAt','updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName','updatedAt']);

      allow delete: if false;
    }

    // Task submissions are immutable from the user's side.
    // No client can approve a task or credit a balance.
    match /taskSubmissions/{submissionId} {
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && submissionId == request.auth.uid + "_" + request.resource.data.taskId
        && request.resource.data.keys().hasOnly([
          'uid','taskId','title','rewardPoints','status','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid','taskId','title','rewardPoints','status','createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.taskId == 'profile'
            && request.resource.data.title == 'প্রোফাইল তথ্য পড়ুন'
            && request.resource.data.rewardPoints == 50)
          || (request.resource.data.taskId == 'safety'
            && request.resource.data.title == 'নিরাপত্তা নির্দেশনা'
            && request.resource.data.rewardPoints == 75)
          || (request.resource.data.taskId == 'feedback'
            && request.resource.data.title == 'ফিডব্যাক ফর্ম দেখুন'
            && request.resource.data.rewardPoints == 100)
          || (request.resource.data.taskId == 'quiz'
            && request.resource.data.title == 'নমুনা কুইজ'
            && request.resource.data.rewardPoints == 125)
        )
        && !exists(/databases/$(database)/documents/taskSubmissions/$(submissionId));

      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedAt == request.time;

      allow delete: if false;
    }


    // Demo farm bookings: no payments, deposits, or profit balances.
    match /farmBookings/{bookingId} {
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && bookingId == request.auth.uid + "_" + request.resource.data.farmId
        && request.resource.data.keys().hasOnly([
          'uid','farmId','farmName','category','status','demoOnly','createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.farmId in [
          'goat_farm_01','farm_enrichment_60','eggplant_farm_49','cucumber_farm_49','shariah_vegetable_01'
        ]
        && request.resource.data.category in ['regular','shariah']
        && request.resource.data.status == 'pending'
        && request.resource.data.demoOnly == true
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/farmBookings/$(bookingId));

      allow update, delete: if false;
    }


    // Demo-only withdrawal requests. No real balance or payment is created.
    match /demoWithdrawalRequests/{requestId} {
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'uid','farmId','points','status','demoOnly','createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid','farmId','points','status','demoOnly','createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.farmId == 'goat_farm_01'
        && request.resource.data.points is int
        && request.resource.data.points >= 500
        && request.resource.data.points <= 3600
        && request.resource.data.status == 'pending'
        && request.resource.data.demoOnly == true
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedAt == request.time;

      allow delete: if false;
    }

    // Demo shop catalog: only admin can create/update products.
    match /shopProducts/{productId} {
      allow get, list: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name','imageUrl','description','demoCoinPrice','demoCommission','active','createdAt','demoOnly'])
        && request.resource.data.name is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 600000
        && (request.resource.data.imageUrl == ''
          || request.resource.data.imageUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+
        && request.resource.data.demoCoinPrice > 0
        && request.resource.data.demoCommission is int
        && request.resource.data.demoCommission >= 0
        && request.resource.data.demoOnly == true
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if false;
    }

    // Demo order requests only: no coin deduction, wallet credit, or payment.
    match /shopOrders/{orderId} {
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','productId','productName','demoCoinPrice','demoCommission','status','demoOnly','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.demoCoinPrice is int
        && request.resource.data.demoCoinPrice > 0
        && request.resource.data.demoCommission is int
        && request.resource.data.demoCommission >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.demoOnly == true
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // All other collections remain closed by default.
  }
}))
        && request.resource.data.demoCoinPrice is int
        && request.resource.data.demoCoinPrice > 0
        && request.resource.data.demoCommission is int
        && request.resource.data.demoCommission >= 0
        && request.resource.data.demoOnly == true
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']);
      allow delete: if false;
    }

    // Demo order requests only: no coin deduction, wallet credit, or payment.
    match /shopOrders/{orderId} {
      allow get, list: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','productId','productName','demoCoinPrice','demoCommission','status','demoOnly','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productName is string
        && request.resource.data.demoCoinPrice is int
        && request.resource.data.demoCoinPrice > 0
        && request.resource.data.demoCommission is int
        && request.resource.data.demoCommission >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.demoOnly == true
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt'])
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    // All other collections remain closed by default.
  }
}